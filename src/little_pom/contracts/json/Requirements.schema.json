{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirements",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source": {
      "const": "valid"
    },
    "card_id": {
      "type": "string",
      "minLength": 1
    },
    "frozen": {
      "const": true
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "task_id",
    "tags",
    "source",
    "card_id",
    "frozen",
    "diagnostics"
  ],
  "additionalProperties": false
}

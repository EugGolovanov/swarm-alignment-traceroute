{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageManifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "ok",
        "incomplete"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    },
    "completed_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "stage",
    "config_hash",
    "input_hash",
    "outputs",
    "status",
    "error",
    "completed_at"
  ],
  "additionalProperties": false
}

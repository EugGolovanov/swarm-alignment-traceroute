{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fragment": {
      "type": "string"
    },
    "fragment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "source",
        "generated"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "task_id",
    "evidence_id",
    "source",
    "source_sha256",
    "fragment",
    "fragment_sha256",
    "kind"
  ],
  "additionalProperties": false
}

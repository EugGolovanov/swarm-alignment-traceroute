{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScientificRubricVerdicts",
  "type": "object",
  "properties": {
    "criteria_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "verdict": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "verdict",
          "explanation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "criteria_results"
  ],
  "additionalProperties": false
}
